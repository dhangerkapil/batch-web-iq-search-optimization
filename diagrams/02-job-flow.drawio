<mxfile host="app.diagrams.net" type="device">
  <diagram id="job-flow" name="One job through run">
    <mxGraphModel dx="1920" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="One job through two_stage.py run (option 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#1F2937;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="1000" height="44" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Re-run the same command to resume after an interruption. &lt;br&gt;Finished searches are never repeated." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=1;fontFamily=Segoe UI;fontSize=14;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
