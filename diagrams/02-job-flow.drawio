<mxfile host="app.diagrams.net" type="device">
  <diagram id="job-flow" name="One job through run">
    <mxGraphModel dx="1920" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="One job through two_stage.py run (option 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#1F2937;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="1000" height="44" as="geometry" />
        </mxCell>

        <mxCell id="note" value="One command runs the job to the end.&lt;br&gt;Re-run the same command to resume after an interruption:&lt;br&gt;finished searches and settled lines are never sent again." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=1;fontFamily=Segoe UI;fontSize=14;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1480" y="22" width="420" height="76" as="geometry" />
        </mxCell>

        <mxCell id="load" value="Load records&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;(a job already done just reports its results)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="plan" value="Build search plan (lean or full)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="242" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="fc1" value="Forecast 1 (estimated input tokens,&lt;br&gt;list prices read live)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="354" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="gate1" value="Above --max-cost?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="466" width="280" height="112" as="geometry" />
        </mxCell>

        <mxCell id="stop1" value="&lt;font color=&quot;#C2410C&quot;&gt;&lt;b&gt;STOP (exit 1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nothing called" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="478" width="380" height="88" as="geometry" />
        </mxCell>

        <mxCell id="search" value="Run searches through Web IQ: rate-limited (--qps), connections kept open, up to 6 attempts each with backoff;&lt;br&gt;still failing with 408, 429, 5xx or a network error: 2 more rounds by themselves, 60 s and 300 s later.&lt;br&gt;Each saved as it finishes.&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;(A refused search, HTTP 400, 401, 403, 404 or 422, is not sent again.)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F4F3;strokeColor=#0E7C7B;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="618" width="840" height="116" as="geometry" />
        </mxCell>

        <mxCell id="gate2" value="Searches still failing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="780" width="280" height="112" as="geometry" />
        </mxCell>

        <mxCell id="hold" value="&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;HOLD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;the records that need them (held-records.jsonl);&lt;br&gt;the others go on&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Every record held: STOP, exit 1 if a 4xx needs a person,&lt;br&gt;else exit 3&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="774" width="380" height="124" as="geometry" />
        </mxCell>

        <mxCell id="batchfile" value="Build no-tools batch file&lt;br&gt;(evidence + rules + JSON schema)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="946" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="fc2" value="Forecast 2 (prompt text counted exactly)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1058" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="gate3" value="Above --max-cost?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1070" y="130" width="280" height="112" as="geometry" />
        </mxCell>

        <mxCell id="stop3" value="&lt;font color=&quot;#C2410C&quot;&gt;&lt;b&gt;STOP (exit 1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Searches done; batch not submitted" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="142" width="400" height="88" as="geometry" />
        </mxCell>

        <mxCell id="upload" value="Upload the file (14-day expiry backstop);&lt;br&gt;above 100,000 lines or 200 MB,&lt;br&gt;split into several batch jobs" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="282" width="420" height="88" as="geometry" />
        </mxCell>

        <mxCell id="create" value="Create each batch job once: SDK retries off,&lt;br&gt;every attempt recorded first; after a create&lt;br&gt;with no answer, list the jobs before trying again" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="410" width="420" height="112" as="geometry" />
        </mxCell>

        <mxCell id="quota" value="&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;WAIT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Quota full (token_limit_exceeded),&lt;br&gt;whether the create is refused or the job&lt;br&gt;fails after validating: create again from&lt;br&gt;the same upload, 5 s doubling to 600 s,&lt;br&gt;up to 24 hours; not a round. Then exit 75" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="386" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="poll" value="Wait: poll every 60 s until every job ends&lt;br&gt;(no time limit unless --max-wait-minutes: exit 75);&lt;br&gt;warn on a stall" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="562" width="420" height="88" as="geometry" />
        </mxCell>

        <mxCell id="collect" value="Collect the output and error files; sort each line" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="690" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="gate4" value="Lines failed with&lt;br&gt;408, 429, 5xx&lt;br&gt;or not processed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="802" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="again" value="&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;SEND AGAIN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;in a new batch job, by itself: round 2, then 3.&lt;br&gt;Still failing after round 3: HOLD" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="824" width="400" height="96" as="geometry" />
        </mxCell>

        <mxCell id="write" value="Write results.jsonl, held-records.jsonl&lt;br&gt;and the actual cost to run.json" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="982" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="cleanup" value="Clean up: delete the batch files in Azure OpenAI&lt;br&gt;and the local evidence" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1094" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="done" value="Done: exit 0, or 3 if records are held" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1206" width="360" height="56" as="geometry" />
        </mxCell>

        <mxCell id="exits" value="Exit codes, for a scheduler: &lt;b&gt;0&lt;/b&gt; done; &lt;b&gt;3&lt;/b&gt; records held (run held-records.jsonl as a new job later); &lt;b&gt;1&lt;/b&gt; needs a person (a --max-cost forecast, sign-in or access, a 4xx, a job that failed validation); &lt;b&gt;75&lt;/b&gt; run the same command again later; &lt;b&gt;130&lt;/b&gt; interrupted (Ctrl+C)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=1;fontFamily=Segoe UI;fontSize=14;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="1308" width="1880" height="48" as="geometry" />
        </mxCell>

        <mxCell id="e_load_plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B5563;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="plan">
