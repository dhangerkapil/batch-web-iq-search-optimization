        </mxCell>

        <mxCell id="upload" value="Upload file (14-day expiry backstop) &lt;br&gt;and create batch job" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
