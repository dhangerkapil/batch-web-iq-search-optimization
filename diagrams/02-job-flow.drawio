        <mxCell id="plan" value="Build search plan (lean or full)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="fc1" value="Forecast 1 (estimated input tokens)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="370" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="gate1" value="Above --max-cost?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="490" width="280" height="112" as="geometry" />
        </mxCell>

        <mxCell id="stop1" value="&lt;font color=&quot;#C2410C&quot;&gt;&lt;b&gt;STOP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nothing called" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="502" width="400" height="88" as="geometry" />
        </mxCell>

        <mxCell id="search" value="Run searches: rate-limited, retried with backoff, &lt;br&gt;each saved as it finishes" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E6F4F3;strokeColor=#0E7C7B;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="420" height="72" as="geometry" />
        </mxCell>

        <mxCell id="gate2" value="Any failed searches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#0F4C81;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="770" width="280" height="112" as="geometry" />
        </mxCell>

        <mxCell id="stop2" value="&lt;font color=&quot;#C2410C&quot;&gt;&lt;b&gt;STOP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nothing submitted; &lt;br&gt;re-run retries only the failed searches" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
